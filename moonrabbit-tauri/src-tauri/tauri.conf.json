{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moonrabbit",
  "version": "0.1.0",
  "identifier": "cn.moonrabbit.desktop",
  "build": {
    "frontendDist": "../../rabbit-web-generic",
    "devUrl": "http://127.0.0.1:3081"
  },
  "app": {
    "windows": [
      {
        "title": "Moonrabbit",
        "width": 1280,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon-512.png"
    ]
  }
}
